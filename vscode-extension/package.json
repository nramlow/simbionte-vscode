{
  "name": "simbionte",
  "displayName": "Simbionte",
  "description": "Live Claude Code panel: plan progress, files touched and session state (working, waiting for you, running a command, stuck).",
  "version": "1.1.0",
  "publisher": "OSCARWILDERROJASRIVERO4849",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/dragonfurioso35-art/simbionte-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/dragonfurioso35-art/simbionte-vscode/issues"
  },
  "homepage": "https://github.com/dragonfurioso35-art/simbionte-vscode#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "ai",
    "agent",
    "hooks",
    "progress",
    "plans",
    "superpowers"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "simbionte",
          "title": "Simbionte",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "simbionte": [
        {
          "type": "webview",
          "id": "simbionte.painel",
          "name": "Simbionte"
        }
      ]
    },
    "commands": [
      {
        "command": "simbionte.instalarHooks",
        "title": "Simbionte: Install Claude Code hooks"
      },
      {
        "command": "simbionte.removerHooks",
        "title": "Simbionte: Remove Claude Code hooks"
      }
    ],
    "configuration": {
      "title": "Simbionte",
      "properties": {
        "simbionte.stuckThresholdMinutes": {
          "type": "number",
          "default": 15,
          "minimum": 1,
          "description": "Minutes without any signal, while Claude Code is working, before warning that the session is \"possibly stuck\". Waiting for you, running a command, or an ended session never trigger the warning."
        },
        "simbionte.limiteTravadoMin": {
          "type": "number",
          "default": 15,
          "minimum": 1,
          "deprecationMessage": "Use \"Simbionte: Stuck Threshold Minutes\" instead. Still honored if the new setting is not set.",
          "description": "Deprecated: old name of Stuck Threshold Minutes."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node prepare.js"
  }
}
